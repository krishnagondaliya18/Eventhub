          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 400 (if already exists)', function () {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.test('Response has success and token', function () {",
                  "        pm.expect(json.success).to.be.true;",
                  "        pm.expect(json.token).to.be.a('string');",
                  "        pm.expect(json.user).to.be.an('object');",
                  "    });",
                  "    pm.environment.set('authToken', json.token);",
                  "    pm.environment.set('userId', json.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
